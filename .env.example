# Environment variables untuk template NusantaraKini.
# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# Template ini berjalan tanpa backend (data mock) — variabel di bawah OPSIONAL.

# Nama situs yang tampil di metadata (opsional).
NEXT_PUBLIC_SITE_NAME=NusantaraKini

# URL publik situs (opsional, dipakai untuk metadataBase/SEO).
NEXT_PUBLIC_SITE_URL=
